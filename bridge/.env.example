# Copy this file to `.env` and fill in the values, then run `npm install && npm start`.
# The service-role key stays ONLY on this PC — it is never shipped to the browser.

# Supabase project URL (same one ORION uses).
SUPABASE_URL=

# Supabase service-role key (Dashboard > Settings > API > service_role).
# Never put this in the ORION client code.
SUPABASE_SERVICE_ROLE_KEY=

# Directory where `freebuff` runs. Defaults to the ORION repo root.
WORKING_DIR=C:\Users\edoar\second-brain

# The command used to launch Freebuff (no arguments).
FREEBUFF_COMMAND=freebuff

# Branch Freebuff must never work on directly. Tasks branch off this.
MAIN_BRANCH=main

# ── Timing (milliseconds) ─────────────────────────────────────────
# How often the Bridge polls Supabase for new tasks.
POLL_INTERVAL_MS=2000
# How often the Bridge polls the command channel (stop / approve / discard).
# Kept on a separate, faster loop so a hung task can never block Stop.
COMMAND_POLL_MS=1000
# How long to wait after launching `freebuff` before pressing Enter
# (the "interface has initialised" delay).
INIT_WAIT_MS=4000
# How long to wait after pressing Enter before sending the initial prompt.
PROMPT_SETTLE_MS=3000
# Quiet period required (no new terminal output) before a follow-up is sent.
FOLLOWUP_SETTLE_MS=2500
# How long to wait after Ctrl+C before force-terminating on Stop.
STOP_TIMEOUT_MS=10000
# Hard cap on any single git command so a hung push/checkout can't wedge the Bridge.
GIT_TIMEOUT_MS=30000

# ── Terminal output ───────────────────────────────────────────────
# Flush buffered terminal output to Supabase at most every N ms.
TERMINAL_FLUSH_MS=600
# Keep at most this many output chunks per task (older chunks are pruned).
TERMINAL_MAX_CHUNKS=2000

# ── Git / Vercel ──────────────────────────────────────────────────
# Push the task branch to origin so Vercel's Git integration builds a preview.
PUSH_BRANCH=true
# Push main after Approve so Vercel deploys production.
PUSH_MAIN_ON_APPROVE=true

# Optional: a JS RegExp that, when matched in terminal output, marks the
# task ready for review even while the session is still open. Leave empty
# to rely on process exit (the default).
DONE_MARKER=
